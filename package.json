{
  "name": "habitify-sync",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "test": "vitest run --passWithNoTests && vitest run --config test/settings-manifest.vitest.config.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.node-scripts.json",
