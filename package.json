    "generate:settings-manifest": "vitest run --config scripts/generate-settings-manifest.vitest.config.ts"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.12.0",
    "@cloudflare/workers-types": "^4.20260101.0",
    "@types/node": "^26.1.2",
    "typescript": "^5.6.0",
    "vitest": "^3.0.0",
    "wrangler": "~4.107.1"
  }
}
